# ===== 分析引擎：DeepSeek（必填，Phase 1 起生效）=====
# 把你的 DeepSeek API Key 填到 config/.env（已 gitignore，不会入库）
# 该 Key 同时驱动：JD 元信息识别（公司名/职位名/软技能）与 Phase4 薪资市场区间估算
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 应用 =====
APP_TITLE=AI 求职助手
