# Streamlit Cloud secrets 配置模板
#
# 两种用法（二选一）：
# 1) 部署到 Streamlit Community Cloud 时：在 App 的 Settings -> Secrets 里粘贴以下内容
#    （不要把这个真实文件提交到 git；本模板才是入库参考）。
# 2) 本地想用 secrets 机制代替 config/.env 时：复制本文件为 .streamlit/secrets.toml
#    （已被 .gitignore 排除，不会入库）。
#
# 这些顶层键会被 Streamlit 注入为环境变量，代码里通过 os.getenv 读取
# （core/llm.py 的 DeepSeekClient、app/storage.py 的 DB_PATH）。

DEEPSEEK_API_KEY = "在这里填你的 DeepSeek API Key"
DEEPSEEK_MODEL = "deepseek-v4-flash"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"

# 可选：覆盖数据库路径（指向持久卷/外部存储）。默认 data/app.db（云平台重新部署会重置）。
# APP_DB_PATH = "/mount/data/app.db"
